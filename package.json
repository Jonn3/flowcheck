{
  "name": "flowcheck",
  "version": "0.1.0",
  "private": true,
  "description": "Interactive workflow simulation: investigate a failing customer implementation, change a rule and replay it.",
  "type": "module",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "test": "node --test \"tests/*.test.ts\"",
    "build": "node scripts/build.mjs",
    "verify": "node scripts/verify.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test:browser": "node tests/browser/smoke.cjs"
  },
  "devDependencies": {
    "typescript": "^6.0.0"
  }
}
